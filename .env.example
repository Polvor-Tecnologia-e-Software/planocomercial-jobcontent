# Variáveis validadas por src/config/env.client.ts (NEXT_PUBLIC_*) e
# src/config/env.server.ts (as demais). Copie para .env.local e preencha.
#
#   cp .env.example .env.local
#
# NUNCA use NEXT_PUBLIC_* para segredos — qualquer variável com esse
# prefixo é embutida no código enviado ao navegador do usuário.

# ─── Supabase ────────────────────────────────────────────────────────────────
# URL e chave anônima: públicas por design, protegidas pelas policies de
# Row Level Security (ver supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave privilegiada — IGNORA Row Level Security. Nunca prefixe com
# NEXT_PUBLIC_, nunca exponha ao navegador. Usada apenas em código
# server-only (ver src/lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Inteligência artificial (OpenAI) ──────────────────────────────────────────
AI_API_KEY=sk-...
AI_MODEL=gpt-4o

# ─── RD Station ───────────────────────────────────────────────────────────────
# Integração de Conversão via API Key (RD Station Marketing — CDP), ver
# src/lib/rd-station/. Sem esta variável, a integração fica silenciosamente
# desativada — nunca bloqueia o restante da jornada (diagnóstico, plano, PDF).
RD_STATION_API_KEY=your-rd-station-api-key

# Reservadas para uma eventual integração OAuth futura (NÃO usadas pela
# integração de Conversão via API Key acima) — não remova só por estarem
# sem uso; src/config/env.server.ts as trata como opcionais.
RD_STATION_CLIENT_ID=your-client-id
RD_STATION_CLIENT_SECRET=your-client-secret
RD_STATION_REFRESH_TOKEN=your-refresh-token

# ─── Aplicação ─────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
